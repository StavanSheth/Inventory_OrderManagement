# ==============================================================================
# MELT INVENTORY & ORDER MANAGEMENT - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env or .env.local for development.
# In production, configure environment variables in your deployment environment
# (e.g., Cloudflare Workers secrets or hosting provider dashboard).
#
# DO NOT COMMIT REAL SECRETS OR PRIVATE KEYS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Runtime
# ------------------------------------------------------------------------------
# Options: development | staging | production | test
NODE_ENV=development

# Server port for local development
PORT=3000

# Canonical API base URL (must NOT be localhost in staging or production)
API_BASE_URL=http://localhost:3000

# Allowed CORS origins (comma-separated list; must NOT contain localhost in staging/production)
ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Database Binding (Cloudflare D1 / Local SQLite)
# ------------------------------------------------------------------------------
# D1 binding name configured in wrangler.jsonc (default: DB)
D1_BINDING_NAME=DB

# Path for persistent local SQLite database file (used in local development)
DB_PATH=.data/local.sqlite

# ------------------------------------------------------------------------------
# 3. Firebase Authentication (Google OAuth & Token Verification)
# ------------------------------------------------------------------------------
# Firebase Project ID (REQUIRED in staging and production)
FIREBASE_PROJECT_ID=melt-icecream-staging
NEXT_PUBLIC_FIREBASE_PROJECT_ID=melt-icecream-staging

# Firebase Public Client API Key (used for client SDK initialization)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExamplePublicApiKeyForClientSideOnly
FIREBASE_PUBLIC_API_KEY=AIzaSyExamplePublicApiKeyForClientSideOnly

# Firebase Authentication Domain
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=melt-icecream-staging.firebaseapp.com
FIREBASE_AUTH_DOMAIN=melt-icecream-staging.firebaseapp.com

# Firebase Client Email (optional server service account identifier)
FIREBASE_CLIENT_EMAIL=

# ------------------------------------------------------------------------------
# 4. Background Cron Security
# ------------------------------------------------------------------------------
# Shared secret for authenticating scheduled cron invocations (e.g. order expiry)
# In production, HTTP requests to /api/v1/cron/orders/expire must provide this
# in 'Authorization: Bearer <CRON_SECRET>' or 'x-cron-secret: <CRON_SECRET>'
CRON_SECRET=

# ------------------------------------------------------------------------------
# 5. Feature Flags
# ------------------------------------------------------------------------------
# Enable realtime Server-Sent Events (SSE) streaming (true / false)
ENABLE_REALTIME=true

# Enable dummy WhatsApp notifications (true / false)
ENABLE_DUMMY_WHATSAPP=true

# Enable coupons and promotions subsystem (true / false)
ENABLE_COUPONS=true
