{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inventory-ordermanagement",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": ".next",

  // Authoritative D1 database binding for Cloudflare Workers / Next.js runtime.
  // In production, the Worker runtime accesses the database via `env.DB`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inventory_ordermanagement_db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "database/migrations"
    }
  ],

  // Scheduled Worker Cron Triggers (Order expiry job runs every minute)
  "triggers": {
    "crons": ["* * * * *"]
  },

  // Environment-specific configurations
  "env": {
    "production": {
      "vars": {
        "NODE_ENV": "production",
        "API_BASE_URL": "https://icecream-melt.com",
        "ENABLE_REALTIME": "true"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "inventory_ordermanagement_prod_db",
          "database_id": "a0000000-0000-4000-8000-000000000001",
          "migrations_dir": "database/migrations"
        }
      ]
    },
    "staging": {
      "vars": {
        "NODE_ENV": "staging",
        "API_BASE_URL": "https://staging.icecream-melt.com",
        "ENABLE_REALTIME": "true"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "inventory_ordermanagement_staging_db",
          "database_id": "a0000000-0000-4000-8000-000000000002",
          "migrations_dir": "database/migrations"
        }
      ]
    },
    "development": {
      // Local development runs via persistent SQLite adapter (.data/local.sqlite)
      // or `wrangler dev --local`
      "vars": {
        "NODE_ENV": "development",
        "API_BASE_URL": "http://localhost:3000",
        "ENABLE_REALTIME": "true"
      }
    }
  }
}
